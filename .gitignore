# Build artifacts / payloads (fetched or generated, never committed)
*.zip
*.apk
*.apk.asc
*.part

# Generated at build time by build-microg-ota.sh (version banner + the
# ACTION=install|uninstall marker the unified update-binary dispatches on).
package/version.env
package/action.env

# Packaged XMLs, including those (re)generated at build time
package/**/*.xml
package/**/*.xml

# Repo-local cache fallback (used only when no XDG/~/.cache is available)
.cache/

# OS / editor cruft
.DS_Store
*~
*.swp
*.swo
.idea/
.vscode/

# Temp
*.tmp
*.log
