#!/sbin/sh
#
# Unified recovery updater entry point for BOTH the microG installer and
# uninstaller. $1 = API version, $2 = command-pipe fd, $3 = this zip.
#
# build-microg-ota.sh stamps an action.env (ACTION=install|uninstall) into each
# zip; this single script dispatches on it. Minimal bootstrap only: detect
# bootmode (to pick the work dir), unpack the package, then hand off to the
# shared helpers in recovery-tools.sh.

outfd="/proc/self/fd/$2"
zipfile="$3"

ps | grep zygote | grep -v grep >/dev/null && bootmode=true || bootmode=false
$bootmode || ps -A 2>/dev/null | grep zygote | grep -v grep >/dev/null && bootmode=true
[ "$BOOTMODE" = true ] && bootmode=true

# Ensure /dev/random has entropy in recovery (some builds leave it blocking).
$bootmode || mount -o bind /dev/urandom /dev/random

$bootmode && filedir="/dev/tmp/microG" || filedir="/tmp/microG"
[ "$TMPDIR" ] && filedir="$TMPDIR/microG"

mkdir -p "$filedir"
unzip -o "$zipfile" -d "$filedir" >/dev/null || exit 1
cd "$filedir" || exit 1

# Use ./ -- recovery's shell (mksh) treats a slash-less `.` arg as a PATH
# lookup, and cwd is not in PATH, so `. recovery-tools.sh` fails to find it.
. ./recovery-tools.sh

# Which operation is this zip? Three signals, in order of trust:
#   1. action.env (stamped by build-microg-ota.sh) -- authoritative. Travels
#      inside the artifact, immune to renaming and adb-sideload name loss.
#   2. filename hint -- fallback ONLY for hand-built markerless zips. Matched on
#      the basename so a directory like /sdcard/uninstall/ can't trigger it.
#   3. payload presence -- never *initiates* an action, only *vetoes* the wrong
#      one below, so a truncated install zip can't silently uninstall.
ACTION=""
[ -f action.env ] && . ./action.env
if [ -z "$ACTION" ]; then
	case "${zipfile##*/}" in
		*uninstall*|*remove*) ACTION=uninstall ;;
		*)                    ACTION=install   ;;
	esac
fi

# Safety guards: bias toward the non-destructive direction. Uninstall removes
# things, so never uninstall a zip that still carries an install payload, and
# never "install" one that has no payload to install.
[ "$ACTION" = uninstall ] && [ -d product ] && abort "Refusing to uninstall: this zip carries an install payload."
[ "$ACTION" = install ]   && [ ! -d product ] && abort "Refusing to install: no payload in this zip."

# ===========================================================================
# Install
# ===========================================================================
# Copy one payload file into the target partition.
# $1 = display name  $2 = filename  $3 = dir (within product/ and the target)
install() {
	name="$1"
	file="$2"
	dir="$3"
	ui_print "Installing: $name..."
	[ -f "product/$dir/$file" ] || abort "Missing payload: product/$dir/$file"
	mkdir -p "$INSTALL_ROOT/$dir"
	chmod 755 "$INSTALL_ROOT/$dir"
	log "cp product/$dir/$file $INSTALL_ROOT/$dir"
	ui_print "cp product/$dir/$file $INSTALL_ROOT/$dir"
	cp "product/$dir/$file" "$INSTALL_ROOT/$dir" || abort "Couldn't copy $name ($file => $dir)"
	chmod 644 "$INSTALL_ROOT/$dir/$file"
	ui_print 'done'
}

do_install() {
	print_banner "Minimal microG Installer" "The Essentials only microG pack"

	prepare_rom install

	INSTALL_ROOT="$PRODUCT"
	variant="/product"

	# Version metadata: defaults below are overridden by version.env when
	# present. version.env is generated by build-microg-ota.sh (gitignored) so
	# the tracked installer always has a sane fallback even when built by hand.
	ver="0.0.0"
	verc="0"
	date="unknown"
	minsdk="23"
	[ -f version.env ] && . ./version.env

	ui_print " "
	ui_print "Variant: $variant"
	ui_print "Version: $ver"
	ui_print "Release date: $date"
	ui_print " "
	ui_print "Using architecture: $ARCH"
	ui_print "Using SDK level: $BUILD_VERSION_SDK"
	ui_print "Sysroot is on $SYSROOT"
	if [ "$BUILD_VERSION_SDK" -lt "$minsdk" ]; then
		ui_print " "
		ui_print "WARNING: Using an old Android"
		ui_print "Full compatibility not guaranteed"
	fi

	# --- storage guard rails -----------------------------------------------
	# Decide, BEFORE touching /product, whether there is room for the microG
	# core and how much of GmsCore's native libs we can afford to unpack:
	#   * core does not fit           -> abort, write nothing to /product
	#   * core + all libs fit         -> LIBMODE=full   (unpack everything)
	#   * core + only libcronet fits  -> LIBMODE=cronet (light note)
	#   * only the core fits          -> LIBMODE=none   (strong warning)
	# This project exists because sloppy /system flashers filled the partition
	# and bricked devices; do the arithmetic up front and never half-write.
	GMS_APK="product/priv-app/$GMS/$GMS.apk"
	MARGIN_KB=3072   # ~3 MB slack for filesystem overhead / rounding

	avail_kb="$(get_avail_kb "$PRODUCT")"
	{ [ -n "$avail_kb" ] && [ "$avail_kb" -ge 0 ] 2>/dev/null; } || abort "Couldn't determine free space on /product; refusing to write."

	# A re-install overwrites the previous copies, so their current footprint is
	# reclaimable -- count it toward available space (measured before removal,
	# so the abort path leaves the existing install untouched).
	reclaim_kb=0
	for d in "$GSF" "$GMS" "$STORE"; do
		for p in "$PRODUCT/app/$d" "$PRODUCT/priv-app/$d"; do
			[ -d "$p" ] && reclaim_kb=$(( reclaim_kb + $(du -sk "$p" | cut -f1) ))
		done
	done
	avail_kb=$(( avail_kb + reclaim_kb ))

	core_kb="$(du -sk product | cut -f1)"
	libabi="$(pick_apk_abi "$GMS_APK")"
	full_lib_kb=0
	cronet_kb=0
	if [ -n "$libabi" ]; then
		full_lib_kb="$(apk_lib_kb "$GMS_APK" "$libabi")"
		cronet_kb="$(apk_lib_kb "$GMS_APK" "$libabi" "libcronet.")"
	fi

	ui_print " "
	ui_print "Free on /product: ~$(kb_to_mb "$avail_kb") MB"
	ui_print "microG core: ~$(kb_to_mb "$core_kb") MB | native libs: ~$(kb_to_mb "$full_lib_kb") MB (cronet ~$(kb_to_mb "$cronet_kb") MB)"

	if [ "$avail_kb" -lt "$(( core_kb + MARGIN_KB ))" ]; then
		abort "Not enough space on /product for microG (need ~$(kb_to_mb "$(( core_kb + MARGIN_KB ))") MB, have ~$(kb_to_mb "$avail_kb") MB). Nothing was written."
	elif [ -z "$libabi" ]; then
		LIBMODE=none   # APK bundles no native libs; nothing to unpack
	elif [ "$avail_kb" -ge "$(( core_kb + full_lib_kb + MARGIN_KB ))" ]; then
		LIBMODE=full
	elif [ "$avail_kb" -ge "$(( core_kb + cronet_kb + MARGIN_KB ))" ]; then
		LIBMODE=cronet
		ui_print " "
		ui_print "NOTE: limited space -- unpacking libcronet only"
		ui_print "(other GmsCore native libs skipped)."
	else
		LIBMODE=none
		ui_print " "
		ui_print "WARNING: not enough space to unpack even libcronet."
		ui_print "Cronet-dependent apps (e.g. Google Maps) will crash."
		ui_print "Recommended: also install the microG GmsCore APK as a"
		ui_print "normal USER app -- a user install gets its native libs"
		ui_print "unpacked automatically and provides Cronet."
	fi

	ui_print " "
	ui_print "Cleaning up any previous installations..."
	log "Removing duplicates"
	# -f so a fresh install (nothing to remove) does not abort; braces are not
	# portable to all recovery shells, so remove each path explicitly.
	for d in "$GSF" "$GMS" "$STORE"; do
		rm -rf "$PRODUCT/app/$d" "$PRODUCT/priv-app/$d"
		rm -rf "$SYSTEM/app/$d" "$SYSTEM/priv-app/$d"
	done
	rm -f "$PRODUCT/$PERM_PATH/$PERM_GMS" "$PRODUCT/$PERM_PATH/$PERM_STORE"
	rm -f "$SYSTEM/$PERM_PATH/$PERM_GMS"  "$SYSTEM/$PERM_PATH/$PERM_STORE"
	rm -f "$SYSTEM/addon.d/$ADDOND_MICROG"

	# Install locations (GSF_DIR/GMS_DIR/STORE_DIR/PERM_DIR) come from
	# microg-defs.sh. GsfProxy is optional: modern microG GmsCore provides GSF
	# itself, so the package may ship without it.
	if [ -f "product/$GSF_DIR/$GSF.apk" ]; then
		install "$GSF"              $GSF.apk    $GSF_DIR
	else
		ui_print "Skipping $GSF (not bundled)"
	fi
	install "$GMS"                  $GMS.apk    $GMS_DIR
	# Pre-installed apps don't get their JNI libs unpacked by PackageManager, so
	# extract GmsCore's bundled libs (incl. libcronet.<ver>.so) onto disk --
	# otherwise apps pulling Cronet from Play Services (e.g. Google Maps) crash.
	# How much we unpack was decided by the storage guard rails above.
	case "$LIBMODE" in
		full)   extract_native_libs "$INSTALL_ROOT/$GMS_DIR/$GMS.apk" "$INSTALL_ROOT/$GMS_DIR" ;;
		cronet) extract_native_libs "$INSTALL_ROOT/$GMS_DIR/$GMS.apk" "$INSTALL_ROOT/$GMS_DIR" "libcronet." ;;
		none)   ui_print "Skipping native lib unpack (see warning above)." ;;
	esac
	install "$STORE"                $STORE.apk  $STORE_DIR

	install "$GMS permissions"   $PERM_GMS   "$PERM_DIR"
	install "$STORE permissions" $PERM_STORE "$PERM_DIR"

	if [ -f "system/addon.d/$ADDOND_MICROG" ]; then
		ui_print "Installing: addon.d survival script..."
		mkdir -p "$SYSTEM/addon.d"
		cp "system/addon.d/$ADDOND_MICROG" "$SYSTEM/addon.d/" || abort "Couldn't install addon.d script"
		chmod 755 "$SYSTEM/addon.d/$ADDOND_MICROG"
	fi
}

# ===========================================================================
# Uninstall
# ===========================================================================
do_uninstall() {
	print_banner "Minimal microG Uninstaller" "Removes the Essentials only microG pack"

	prepare_rom
	ui_print " "
	ui_print "Sysroot is on $SYSROOT"

	ui_print " "
	ui_print "Removing microG..."

	# -f so missing files do not error; braces are not portable to recovery
	# shells, so remove each path explicitly. Clean both product and system in
	# case an older build installed there. Removing each app directory
	# recursively also clears any native libs the installer unpacked into
	# <app>/lib/<arch>/ (e.g. GmsCore's libcronet.<ver>.so).
	for d in "$GSF" "$GMS" "$STORE"; do
		ui_print "Removing $d"
		rm -rf "$PRODUCT/app/$d" "$PRODUCT/priv-app/$d"
		rm -rf "$SYSTEM/app/$d"  "$SYSTEM/priv-app/$d"
	done

	ui_print "Removing privapp permissions"
	rm -f "$PRODUCT/$PERM_PATH/$PERM_GMS" "$PRODUCT/$PERM_PATH/$PERM_STORE"
	rm -f "$SYSTEM/$PERM_PATH/$PERM_GMS"  "$SYSTEM/$PERM_PATH/$PERM_STORE"

	# Remove the addon.d survival script LAST -- while it is present, an OTA's
	# post-restore step would re-unpack GmsCore's native libs from the (now
	# removed) APK; taking it out ensures nothing regenerates after uninstall.
	ui_print "Removing addon.d survival script"
	rm -f "$SYSTEM/addon.d/$ADDOND_MICROG"
}

# ===========================================================================
# Dispatch
# ===========================================================================
case "$ACTION" in
	install)   do_install ;;
	uninstall) do_uninstall ;;
	*)         abort "Unknown action: $ACTION" ;;
esac

finish
